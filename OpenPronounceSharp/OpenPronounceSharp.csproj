<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>victor-wiki.$(AssemblyName)</PackageId>
    <Version>1.0.0</Version>
    <Authors>victor-wiki</Authors>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <RepositoryUrl>https://github.com/victor-wiki/OpenPronounceSharp</RepositoryUrl>
    <Description>C# implementation of OpenPronounce(https://github.com/Halleck45/OpenPronounce).</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="data\**" />
    <EmbeddedResource Remove="data\**" />
    <None Remove="data\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove=".gitattributes" />
    <None Remove=".gitignore" />
    <None Remove="libespeak-ng.dll" />
    <None Remove="libsndfile.dll" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="libsndfile.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  <PackagePath>lib\net10.0</PackagePath>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fastenshtein" Version="1.0.12" />
    <PackageReference Include="FFMpegCore" Version="5.5.0" />
    <PackageReference Include="NAudio.SoundFile" Version="3.4.0-preview.1" />
    <PackageReference Include="NumSharp" Version="0.70.0" />
    <PackageReference Include="victor-wiki.EdgeTtsSharp" Version="1.0.0" />
    <PackageReference Include="victor-wiki.FastDtwSharp" Version="1.0.0" />
    <PackageReference Include="victor-wiki.PhonemizerSharp" Version="1.0.1" />
    <PackageReference Include="victor-wiki.TransformersSharp" Version="1.0.0" />
  </ItemGroup>

</Project>
